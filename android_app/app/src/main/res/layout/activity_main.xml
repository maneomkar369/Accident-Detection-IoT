<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1A1A2E">

    <!-- App icon / branding -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Accident Monitor"
        android:textSize="22sp"
        android:textColor="#E0E0E0"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="48dp"/>

    <!-- Status indicator card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#16213E"
        app:cardElevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIREBASE STATUS"
                android:textSize="12sp"
                android:textColor="#7E8C8D"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Monitoring..."
                android:textSize="18sp"
                android:textColor="#00B4D8"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Live indicator -->
    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/circle_green"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listening to users/user_123/status"
        android:textSize="12sp"
        android:textColor="#7E8C8D"/>

</LinearLayout>
