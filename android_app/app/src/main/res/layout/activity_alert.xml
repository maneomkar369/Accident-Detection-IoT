<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#B71C1C">

    <!-- Warning icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="72sp"
        android:layout_marginBottom="12dp"/>

    <!-- Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCIDENT DETECTED!"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="6dp"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency contacts will be notified in:"
        android:textSize="15sp"
        android:textColor="#FFCDD2"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Countdown circle -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:gravity="center"
        android:text="10"
        android:textSize="64sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-black"
        android:background="@drawable/circle_red_outline"
        android:layout_marginBottom="28dp"/>

    <!-- Location row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 "
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fetching location..."
            android:textSize="14sp"
            android:textColor="#FFCDD2"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- ── I AM OKAY (DENY) button ─────────────────────────── -->
    <Button
        android:id="@+id/denyButton"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:text="✅  I AM OKAY  (DENY)"
        android:textSize="20sp"
        android:textColor="#B71C1C"
        android:fontFamily="sans-serif-black"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:elevation="8dp"/>

    <!-- ── SEND HELP NOW (CONFIRM) button ─────────────────── -->
    <Button
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:text="🆘  SEND HELP NOW"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-black"
        android:backgroundTint="#FF6D00"
        android:layout_marginBottom="16dp"
        android:elevation="8dp"/>

    <!-- Helper -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="If you do not press any button, an SMS + call will be sent automatically."
        android:textSize="12sp"
        android:textColor="#FFCDD2"
        android:gravity="center"/>

</LinearLayout>
