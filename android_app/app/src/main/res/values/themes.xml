<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.AccidentDetect" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">#1A1A2E</item>
        <item name="colorPrimaryVariant">#16213E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#00B4D8</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">#0F3460</item>
    </style>

    <!-- Full-screen alert theme (no action bar) -->
    <style name="Theme.AccidentDetect.Alert" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#B71C1C</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
